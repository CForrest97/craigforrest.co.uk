---
import '../styles/global.css';
import { experience } from '../data/experience';
import { contactLinks } from '../data/contact';
import publicSansRegularUrl from '@fontsource/public-sans/files/public-sans-latin-400-normal.woff2?url';
import newsreaderSemiboldUrl from '@fontsource/newsreader/files/newsreader-latin-600-normal.woff2?url';
import ibmPlexMonoRegularUrl from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';

const title = 'Craig Forrest — Senior Software Engineer';
const description =
	'Craig Forrest is a hands-on senior software engineer with a product focus, working across web applications, cloud infrastructure and technical delivery.';
---

<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<meta name="theme-color" content="#0f766e" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preload" href={publicSansRegularUrl} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={newsreaderSemiboldUrl} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={ibmPlexMonoRegularUrl} as="font" type="font/woff2" crossorigin />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to main content</a>

		<header class="site-header">
			<div class="site-header__inner">
				<a class="wordmark" href="/">Craig Forrest</a>
				<nav aria-label="Page sections">
					<a href="#experience">Experience</a>
					<a href="#contact">Contact</a>
				</nav>
			</div>
		</header>

		<main id="main" class="page" tabindex="-1">
			<section id="about" aria-labelledby="about-heading">
				<h1 id="about-heading">Craig Forrest</h1>
				<p class="role">Senior Software Engineer</p>
				<div class="introduction">
					<p class="intro">
						I’m a hands-on software engineer with a product focus. I care about understanding the
						problem, building the right thing and seeing it through to release and beyond.
					</p>
					<p>
						My experience spans web applications and cloud infrastructure, with responsibility
						across shaping solutions, development, deployment and ongoing operation. I’ve also led
						technical delivery, helped teams make decisions and supported other engineers through
						pairing.
					</p>
					<p>
						I focus on impact: understanding what will make a product useful, then using code to
						make it happen.
					</p>
				</div>
			</section>

			<section id="experience" aria-labelledby="experience-heading">
				<h2 id="experience-heading">Experience</h2>
				<dl class="experience-list">
					{
						experience.map(({ company, role }) => (
							<div class="experience-item">
								<dt>{company}</dt>
								<dd>{role}</dd>
							</div>
						))
					}
				</dl>
			</section>

			<section id="contact" aria-labelledby="contact-heading">
				<h2 id="contact-heading">Get in touch</h2>
				<ul class="contact-list">
					{
						contactLinks.map(({ href, label }) => (
							<li>
								<a href={href}>{label}</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>

		<style>
			main,
			main section {
				scroll-margin-top: var(--space-5);
			}

			.page,
			.site-header__inner {
				width: min(100%, var(--max-width-content));
				margin: 0 auto;
				padding-inline: var(--space-5);
			}

			.site-header {
				padding-top: env(safe-area-inset-top, 0px);
				border-bottom: 1px solid var(--color-border);
			}

			.site-header__inner {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: var(--space-5);
				padding-block: var(--space-4);
			}

			.wordmark {
				font-family: var(--font-serif);
				font-weight: 600;
				font-size: 18px;
				color: var(--color-text-primary);
				text-decoration: none;
			}

			.site-header nav {
				display: flex;
				gap: var(--space-5);
			}

			.site-header nav a {
				font-size: var(--text-body-sm);
				color: var(--color-text-secondary);
				text-decoration: none;
			}

			.wordmark:hover,
			.site-header nav a:hover {
				color: var(--color-accent-text);
			}

			#about {
				padding-block: var(--space-8) var(--space-7);
			}

			#about h1 {
				font-size: var(--text-display-2);
				line-height: var(--leading-tight);
				margin: 0;
			}

			.role {
				font-family: var(--font-mono);
				font-size: var(--text-body-sm);
				color: var(--color-accent-text);
				margin: var(--space-3) 0 var(--space-6);
			}

			.introduction {
				max-width: 640px;
				color: var(--color-text-secondary);
				line-height: var(--leading-relaxed);
			}

			.introduction p {
				margin: 0 0 var(--space-5);
			}

			.introduction p:last-child {
				margin-bottom: 0;
			}

			.intro {
				font-size: var(--text-body-lg);
				color: var(--color-text-primary);
			}

			#experience,
			#contact {
				padding-block: var(--space-6) var(--space-7);
				border-top: 1px solid var(--color-border);
			}

			h2 {
				font-size: var(--text-h2);
				line-height: var(--leading-tight);
				margin: 0 0 var(--space-5);
			}

			.experience-list {
				margin: 0;
			}

			.experience-item {
				display: grid;
				grid-template-columns: 1fr 1.5fr;
				gap: var(--space-2) var(--space-5);
				padding-block: var(--space-3);
			}

			.experience-item dt {
				font-weight: 600;
			}

			.experience-item dd {
				margin: 0;
				color: var(--color-text-secondary);
			}

			#contact {
				padding-bottom: calc(var(--space-8) + env(safe-area-inset-bottom, 0px));
			}

			.contact-list {
				list-style: none;
				margin: 0;
				padding: 0;
				display: flex;
				flex-wrap: wrap;
				gap: var(--space-3) var(--space-5);
			}

			.contact-list a {
				font-family: var(--font-mono);
				font-size: var(--text-body-sm);
				text-underline-offset: 4px;
				overflow-wrap: anywhere;
			}

			.contact-list a:hover {
				color: var(--color-accent-hover);
			}

			@media (max-width: 480px) {
				.site-header__inner {
					flex-wrap: wrap;
					gap: var(--space-3) var(--space-5);
				}

				#about {
					padding-top: var(--space-7);
				}

				.experience-item {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</body>
</html>
